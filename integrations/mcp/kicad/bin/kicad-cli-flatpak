#!/usr/bin/python3 -I
"""Pinned adapter for KICAD_CLI_PATH, with a fixed app and bounded argv."""

import os
import sys
from pathlib import Path


def main() -> None:
    sys.dont_write_bytecode = True
    sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
    from solus.development.cli import flatpak_argv
    from solus.development.models import DevelopmentError

    try:
        argv = flatpak_argv(sys.argv[1:])
    except DevelopmentError as error:
        print(error.reason, file=sys.stderr)
        raise SystemExit(2) from None
    os.execv(argv[0], argv)  # noqa: S606 — fixed /usr/bin/flatpak, validated argv only


if __name__ == "__main__":
    main()
