# `gz model -w default -m broken -f <urdf without joint effort>`: stderr, rc 0 (the build-tree
# paths are urdfdom's own, as printed).
_URDFDOM = (
    "/home/conda/feedstock_root/build_artifacts/bld/"
    "rattler-build_urdfdom_h57aec1e_1793831053/work/urdf_parser/src/"
)
SPAWN_PARSE_ERROR = f"""Error:   joint [elbow]: limit has no effort
         at line 176 in {_URDFDOM}joint.cpp
Error:   Could not parse limit element for joint [elbow]
         at line 600 in {_URDFDOM}joint.cpp
Error:   joint xml is not initialized correctly
         at line 243 in {_URDFDOM}model.cpp
Error: SDF parsing the xml failed
"""


def main() -> int:
    args = sys.argv[1:]
    partition = os.environ.get("GZ_PARTITION")
    paused = partition == "solus-fixture-paused"
    nonfinite = partition == "solus-fixture-nonfinite"
    if args == ["topic", "-l"]:
        idle = partition == "solus-fixture-idle"
        prefix = f"/gazebo/{WORLD}/"
        topics = [t for t in TOPICS.splitlines() if not (idle and t.startswith(prefix))]
        sys.stdout.write("".join(t + "\n" for t in topics))
        return 0
    if args[:2] == ["topic", "-e"]:
        if "-d" in args and not args[args.index("-d") + 1].isdigit():
            sys.stderr.write("Invalid arguments\n")  # recorded: `-d` takes whole seconds
            return 0
        if args[2] != f"/gazebo/{WORLD}/world_stats":
            time.sleep(float(args[args.index("-d") + 1]) if "-d" in args else 30)
            return 0
        for i in range(2):
            sys.stdout.write(STATS.format(sec=16 if paused else 7 + i, paused=str(paused).lower()))
        return 0
    if args[:1] == ["model"] and "-i" in args:
        model = args[args.index("-m") + 1]
        if model != "twolink":
            sys.stdout.write(f"Unable to get info on model[{model}] in the world[{WORLD}]\n")
            return 0
        sys.stdout.write(
            MODEL_INFO.format(
                shoulder="nan" if nonfinite else "1.5697520194514176",
                elbow="inf" if nonfinite else "1.5464770391330855",
            )
        )
        return 0
    if args[:1] == ["model"] and "-f" in args and args[args.index("-m") + 1] == "broken":
        sys.stderr.write(SPAWN_PARSE_ERROR)  # recorded live in P8-T2 (2026-11-09): rc 0
        return 0
    if args[:1] in (["model"], ["joint"], ["world"]) and "-w" in args:
        return 0  # spawn / --pos-t / -p -s -m -r -t -o: recorded as silent successes
    sys.stderr.write("Invalid arguments\n")
    return 255


sys.exit(main())
