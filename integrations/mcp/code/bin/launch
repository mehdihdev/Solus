#!/bin/sh
# integrations/mcp/code/bin/launch — Solus-authored ADR-031 entrypoint for the
# Solus-authored `code` MCP server (SOLUSDEV-250). This is the ONLY way the
# companion may start this server (integrations/mcp/README.md).
#
# Guarantees (locked by ../tests/test_code_launch_entrypoint.py):
#   * fixed argv — no caller-argument passthrough;
#   * scrubbed child environment — env -i plus the declared allowlist below;
#   * zero network I/O and zero installs at launch (ADR-031). Dependencies are
#     materialized at setup time from requirements.lock.txt (hash-verified)
#     into a per-user app-data env (mcp-envs/code/, ADR-031 amendment
#     2026-11-19); the companion validates that env's interpreter and hands it
#     over as an absolute path in SOLUS_MCP_PYTHON.
#     Nothing here resolves from PATH. (The USER's installs/runs the server
#     later performs on confirmation are the ADR-031 2026-09-07 amendment —
#     they act on the user's workspace environment, never on this one.)
set -eu

BIN_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
FORK_DIR=$(CDPATH= cd -- "$BIN_DIR/.." && pwd)

# The interpreter comes ONLY from SOLUS_MCP_PYTHON, set by the companion after
# it validated the app-data env (inside mcp-envs/, owner-only, stamp matches
# the lockfile). Unset, empty, relative or non-executable -> EX_CONFIG (78):
# never a PATH lookup, never an in-tree fallback.
PYTHON="${SOLUS_MCP_PYTHON:-}"
case "$PYTHON" in
  /*) ;;
  *) PYTHON="" ;;
esac
if [ -z "$PYTHON" ] || [ ! -x "$PYTHON" ]; then
  echo "launch: SOLUS_MCP_PYTHON must be an absolute, executable interpreter set up by Solus" >&2
  exit 78
fi

# The companion passes the linked folder via SOLUS_MCP_WORKSPACE — the one
# documented cwd knob. cwd falls back to the fork dir for stable relative I/O,
# but the child variable is passed through EMPTY when the companion did not
# provide it: solus/workspace.py fails closed on empty, so every tool refuses
# instead of silently acting on the install dir.
WORKSPACE="${SOLUS_MCP_WORKSPACE:-$FORK_DIR}"
cd -- "$WORKSPACE"

# Declared child-environment allowlist — everything else is dropped by env -i.
# The written declaration lives in ../solus/env_allowlist.py; this block must
# match it exactly (pinned by ../tests/test_code_launch_entrypoint.py). PATH
# is a fixed constant (never inherited); the server resolves binaries against
# its own pinned search roots (solus/probe.py). VIRTUAL_ENV is passed through
# only so the server can OVERRIDE it per child (solus/execute.py) — it is
# never trusted. Changing this set is a PROVENANCE re-review trigger.
exec /usr/bin/env -i \
  HOME="${HOME:-}" \
  USER="${USER:-}" \
  LANG="${LANG:-}" \
  LC_ALL="${LC_ALL:-}" \
  TMPDIR="${TMPDIR:-}" \
  VIRTUAL_ENV="${VIRTUAL_ENV:-}" \
  PATH="/usr/bin:/bin" \
  SOLUS_MCP_WORKSPACE="${SOLUS_MCP_WORKSPACE:-}" \
  "$PYTHON" "$FORK_DIR/solus/server.py"
