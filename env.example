# env.example — template for THE env file.
#
# Onboarding:
#   cp env.example .env      # at the REPO ROOT
#   <fill in the blanks>
#
# ONE FILE. `.env` at the repo root is the only env file in this repo, and every
# process reads it directly:
#   · FastAPI      — pydantic Settings, env_file anchored to the repo root
#                    (packages/api/src/solus_api/core/config.py)
#   · Desktop      — Vite envDir points here (apps/desktop/electron.vite.config.ts)
#   · Web          — process.loadEnvFile (apps/web/next.config.mjs)
# Each consumer reads only the keys it recognises: the backend takes SOLUS_*
# (env_prefix="SOLUS_", the rest ignored), Vite exposes ONLY VITE_* to the
# renderer bundle, the waitlist route reads GOOGLE_*. Extra keys are harmless.
#
# Do NOT create per-package .env files. One shadowing the other — with a blank
# value beating a good one — is the failure this layout exists to prevent.
#
# Values are LITERAL. There is no ${VAR} expansion: nothing in the chain
# (pydantic, Vite, process.loadEnvFile) interpolates, so write each value out.
#
# Real environment variables WIN over this file everywhere, which is how CI and
# `pnpm dev:all` inject config (e.g. the Stripe CLI's signing secret).
#
# `.env` is gitignored — never commit real secrets. This .example is safe.

# ---------------------------------------------------------------------------
# Desktop renderer (Vite) — ONLY VITE_* reaches the renderer bundle.
# Keep the /api/v1 suffix: the client appends paths to it, and a bare origin 404s.
# A BLANK value here is treated as unset (falls back to the loopback default);
# it must never be relied on as a value.
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
# Supabase dashboard → Project Settings → API. Blank ⇒ the desktop dev build
# runs the fake-login bypass; a production build refuses to compile.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# FastAPI backend (SOLUS_* — packages/api/src/solus_api/core/config.py)
# ---------------------------------------------------------------------------
# --- Core ---
# dev | staging | prod. Anything but "dev" REFUSES to boot without a real secret
# store (SOLUS_SECRETS_* below) — prod must never run as "dev".
SOLUS_APP_ENV=dev
# Semver reported by /meta and the OpenAPI docs (NOT the /api/v1 route prefix).
SOLUS_API_VERSION=0.1.0
SOLUS_BUILD_SHA=dev
# Async SQLAlchemy DSN. `pnpm db:up` serves user/password/db all `solus`
# on localhost:5432 (docker-compose.dev.yml).
SOLUS_DATABASE_URL=postgresql+asyncpg://solus:solus@localhost:5432/solus
# Backs ARQ background jobs AND turn-admission rate limiting. Unset ⇒ the 429
# path is dead code and the frequency cap silently fails open.
SOLUS_REDIS_URL=redis://localhost:6379/0
# Comma-separated browser/renderer origins allowed by CORS. 5173 is the Vite dev
# server, 4173 its preview server.
SOLUS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
# Dev-only: create tables from ORM metadata on startup. MUST stay false in any
# shared/prod env — schema there is owned by Alembic migrations.
SOLUS_AUTO_CREATE_TABLES=false
# THE ONLY BOOT-BLOCKING KEY. Supabase dashboard → Project Settings → API → JWT
# Secret. Absent ⇒ Settings() raises and uvicorn exits immediately.
SOLUS_SUPABASE_JWT_SECRET=
SOLUS_SUPABASE_JWT_AUDIENCE=authenticated
# REQUIRED for auth against a real Supabase project: modern projects sign ES256
# tokens, verified via the JWKS at {url}/auth/v1/.well-known/jwks.json (ADR-009 /
# SOLUSDEV-152). Unset ⇒ the API rejects every genuine login token with 401.
SOLUS_SUPABASE_URL=
# Service-role key — used ONLY to revoke Supabase sessions on account deletion.
SOLUS_SUPABASE_SERVICE_ROLE_KEY=

# --- Rate limiting ---
SOLUS_RATE_LIMIT_PER_MINUTE=120
# MO-04 classify preview fires on typing pauses — separate, generous bucket.
SOLUS_CLASSIFY_RATE_LIMIT_PER_MINUTE=600

# --- Teams / trial ---
SOLUS_INVITE_TTL_DAYS=7
SOLUS_TRIAL_DAYS=30

# --- Billing (ADR-024) ---
# The Stripe SECRET API key (sk_...) is NOT an env var. It lives in the
# SecretStore under `stripe_api_key` — set it with:
#   uv run stripe-setup put-key
# That store is a table in the DATABASE, so RE-RUN put-key whenever you recreate
# the dev database. Until it exists, checkout returns 503 billing_unconfigured.
#
# Webhook signing secret (whsec_...). For local dev this is the STRIPE CLI's
# secret (`stripe listen --print-secret`), NOT a dashboard endpoint secret — the
# two differ and the wrong one yields 400 invalid_signature on every event.
# `pnpm dev:all` injects it automatically; set it here only for a standalone API.
SOLUS_STRIPE_WEBHOOK_SECRET=
# Bounded free-trial credit grant written at signup (never unlimited).
SOLUS_TRIAL_CREDIT_GRANT=1000
# Max Stripe webhook body we parse, bytes — bounds untrusted input.
SOLUS_STRIPE_WEBHOOK_MAX_BYTES=262144
# plan+interval → recurring Price id. `uv run stripe-setup bootstrap` creates the
# Prices and prints this line ready to paste. While it stays '{}' a webhook can
# pass signature checks, report processed:true, and change nothing.
SOLUS_STRIPE_PLAN_PRICES='{}'
# Credit packs: Stripe Price id → credits granted, e.g. '{"price_x":1000}'.
# Doubles as the set of valid pack price ids. Also printed by `bootstrap`.
SOLUS_STRIPE_PACK_CREDITS='{}'
# Optional display prices for the packs, e.g. '{"price_x":10}'.
SOLUS_STRIPE_PACK_USD='{}'
# Free-trial length applied to a new Stripe subscription (trial_period_days). 0 = none.
SOLUS_STRIPE_TRIAL_DAYS=14
# Where Stripe returns the user after Checkout / the portal (desktop routes).
SOLUS_STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:5173/#/billing?checkout=success
SOLUS_STRIPE_CHECKOUT_CANCEL_URL=http://localhost:5173/#/billing?checkout=cancel
SOLUS_STRIPE_BILLING_PORTAL_RETURN_URL=http://localhost:5173/#/billing

# --- Secret store (SOLUSDEV-103) — BOOT-BLOCKERS outside dev ---
# Auto-selected when SOLUS_SECRETS_BACKEND is UNSET: aws_region + non-dev
# app_env → AWS Secrets Manager; secrets_key → local Fernet store; neither in
# dev → in-memory (tokens lost on every reload). Non-dev with neither refuses
# to start. Uncomment ONLY to force a backend — a blank value ("") is NOT
# "unset" and disables auto-selection entirely:
# SOLUS_SECRETS_BACKEND=aws        # or: local | memory
# Fernet key for the local encrypted store. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep it STABLE: rotating it makes every stored secret undecryptable.
SOLUS_SECRETS_KEY=
# AWS region for Secrets Manager (prod/staging), e.g. us-east-1.
SOLUS_AWS_REGION=

# --- Integration OAuth apps ---
# GitHub OAuth App (github.com/settings/developers); callback must be
# {SOLUS_PUBLIC_API_BASE_URL}/api/v1/integrations/github/oauth/callback.
SOLUS_GITHUB_CLIENT_ID=
SOLUS_GITHUB_CLIENT_SECRET=
# GitLab OAuth application; base URL supports self-hosted instances.
SOLUS_GITLAB_CLIENT_ID=
SOLUS_GITLAB_CLIENT_SECRET=
SOLUS_GITLAB_BASE_URL=https://gitlab.com
# Onshape Integrated Cloud App (SOLUSDEV-96 / CAD-01). OAuth ONLY — an Onshape
# API key pair authenticates the DEVELOPER, not the customer, so it can never
# reach a customer's documents. See docs/integrations/onshape-setup.md.
SOLUS_ONSHAPE_CLIENT_ID=
SOLUS_ONSHAPE_CLIENT_SECRET=
# Where the OAuth callback sends the user back to (desktop deep link/dev page).
SOLUS_OAUTH_REDIRECT_APP=http://localhost:5173/#/onboarding
# Public base URL providers redirect to for callbacks (this API, no /api/v1).
SOLUS_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
# Run source syncs inline in the request — tests/bare dev only; prod uses ARQ.
SOLUS_SYNC_INLINE=true

# --- Tool knowledge base (SOLUSDEV-215 / TU-05) ---
# Salt for the one-way voter hash on tool-knowledge confirm/reject votes, so the
# server-only observation rows cannot be correlated back to a user even with DB
# read access. Unset ⇒ an ephemeral per-process salt and a loud warning: vote
# de-dup then stops surviving a restart, which is dev-only and must never be the
# production path. Rotating it resets de-dup (old rows keep the old hash).
#   python -c "import secrets; print(secrets.token_hex(32))"
SOLUS_TOOLKB_VOTE_SALT=

# --- AI / fingerprint escalation ---
# NOTE — LLM provider API keys are NOT env vars. The orchestration layer
# (packages/api/src/solus_api/orchestration/providers.py) reads them from the
# SecretStore at call time, under these secret names:
#   anthropic_api_key / openai_api_key / google_api_key
# For dev: put the vendor's own name in this file (or export it), then run ONCE:
#   python3 scripts/seed-provider-keys.py
# Without that, every SOL turn fails with ProviderCredentialsMissingError, which
# reads like a misconfiguration and is really a missing step.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
SOLUS_FINGERPRINT_LLM_ENABLED=false
SOLUS_FINGERPRINT_EMBEDDING_ENABLED=false
SOLUS_FINGERPRINT_VISION_ENABLED=false

# ---------------------------------------------------------------------------
# Web marketing site — waitlist route (apps/web/app/api/waitlist/route.js).
# Provide EITHER the full service-account JSON (single line) OR email+key.
# ---------------------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# \n-escaped PEM private key; the route converts \n back to newlines.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Spreadsheet the waitlist appends to; range defaults to Waitlist!A:C in code.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_RANGE='Waitlist!A:C'

# ---------------------------------------------------------------------------
# AWS deploy config. NOT read by application code — deploy pipelines use
# GitLab CI-scoped variables. Kept here so one file documents the whole system.
# ---------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCOUNT=
ECR_REPO=solus/backend
ECR_URI=
DB_SECRET_ARN=
EXEC_ROLE=ecsTaskExecutionRole
INFRA_ROLE=ecsInfrastructureRoleForExpressServices
ECS_CLUSTER=solus-cluster
