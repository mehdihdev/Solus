# Solus desktop renderer environment (Vite exposes only VITE_*-prefixed vars).
# Copy to .env and fill in. NEVER commit real values.

# Supabase Auth (ADR-009). When BOTH are set, the auth doorway uses real
# Supabase (password, magic link, GitHub OAuth). When unset, the app runs a
# dev bypass so the onboarding prototype stays demoable offline.
# GitHub login also needs the provider enabled in Supabase + the loopback
# redirect URL http://localhost:53682/auth/callback allow-listed — see
# docs/qa/COWORK_QA_onboarding-api-integration.md (Flow 5). Works in the
# Electron app only, not the browser preview.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Solus REST API base. Defaults to http://localhost:8000/api/v1 when unset.
# (No live REST calls are made in the current onboarding slice.)
VITE_API_BASE_URL=
