{
  "family": "solus-api",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "runtimePlatform": {
    "operatingSystemFamily": "LINUX",
    "cpuArchitecture": "ARM64"
  },
  "executionRoleArn": "arn:aws:iam::344838028176:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "solus-api",
      "image": "344838028176.dkr.ecr.us-east-1.amazonaws.com/solus/backend:arm-latest",
      "essential": true,
      "portMappings": [{ "containerPort": 8000, "protocol": "tcp" }],
      "secrets": [
        {
          "name": "SOLUS_DATABASE_URL",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:344838028176:secret:solus/staging/db-lxVtVM:database_url::"
        },
        {
          "name": "SOLUS_SUPABASE_JWT_SECRET",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:344838028176:secret:solus/staging/supabase-XXXXXX:jwt_secret::"
        }
      ],
      "environment": [
        { "name": "SOLUS_APP_ENV", "value": "staging" },
        { "name": "SOLUS_AWS_REGION", "value": "us-east-1" },
        {
          "name": "SOLUS_CORS_ORIGINS",
          "value": "http://localhost:5173,http://localhost:3000"
        },
        { "name": "SOLUS_REDIS_URL", "value": "" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/solus/staging/backend",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "api"
        }
      }
    }
  ]
}
