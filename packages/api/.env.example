# Solus API environment. Settings read SOLUS_*-prefixed vars (see core/config.py).
# Copy to packages/api/.env for local dev. NEVER commit real secrets.
# In production these come from AWS Secrets Manager / the runtime env, not a file.

# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED — the API will not start (or won't authenticate) without these.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase Auth JWT secret (ADR-009) — used to verify the access tokens the
# desktop app sends. Required; the app refuses to boot without it.
#   Supabase dashboard → Project Settings → API → JWT Secret.
#   Must be the SAME project the renderer's VITE_SUPABASE_URL points at.
#   NOTE: this is HS256 verification (the legacy shared "JWT secret"). If your
#   Supabase project uses the newer asymmetric signing keys (ES256/RS256 via
#   JWKS), HS256 will reject tokens — tell me and I'll switch to JWKS verify.
SOLUS_SUPABASE_JWT_SECRET=

# Postgres connection (asyncpg driver). Dev = docker-compose.dev.yml `db`.
# Prod = your RDS instance; require TLS, e.g. ...?ssl=require (RDS needs SSL).
SOLUS_DATABASE_URL=postgresql+asyncpg://solus:solus@localhost:5432/solus

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — have safe defaults; set to override (shown = default).
# ─────────────────────────────────────────────────────────────────────────────

SOLUS_APP_ENV=dev                       # dev | staging | production
SOLUS_SUPABASE_JWT_AUDIENCE=authenticated
SOLUS_API_VERSION=0.1.0
SOLUS_BUILD_SHA=dev                     # set to the git SHA in CI for /version
SOLUS_RATE_LIMIT_PER_MINUTE=120         # interim per-process limiter
SOLUS_INVITE_TTL_DAYS=7
SOLUS_TRIAL_DAYS=30

# Browser/renderer origins allowed to call the API (CORS). electron-vite dev = :5173.
# In prod add the packaged app's origin (and any web client origin).
SOLUS_CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Dev only: create tables from the ORM on startup (no Alembic migrations yet).
# MUST stay false/unset in any shared or production environment — prod schema is
# owned by migrations.
SOLUS_AUTO_CREATE_TABLES=true

# Redis URL (ADR-005/019). Declared but NOT used yet — background jobs (ARQ) and
# the Redis-backed budget/rate-limit system arrive in later phases. Set it when
# those land, e.g. redis://localhost:6379/0 (dev) or your ElastiCache endpoint.
# SOLUS_REDIS_URL=

# ─────────────────────────────────────────────────────────────────────────────
# FUTURE PHASES — credentials the code does NOT read yet, listed so you can
# start acquiring them. Do not expect the API to use these today.
# ─────────────────────────────────────────────────────────────────────────────
# SOLUS_ANTHROPIC_API_KEY=     # SOL Agent / LLM reasoning (ADR-010) — Phase 5
# SOLUS_AWS_REGION=            # S3 file storage, Secrets Manager (ADR-006)
# SOLUS_S3_BUCKET=             # CAD/schematic uploads (Integrations/uploads)
# Connector OAuth (Integrations, Phase 3): GitHub / GitLab / Onshape app
#   client id + secret, e.g. SOLUS_GITHUB_CLIENT_ID / _SECRET, etc.
# Billing (deferred): Stripe keys — out of scope this cycle (API.md §7.2.2).
