# .env.mega.example — template for the single source-of-truth env file.
#
# Onboarding:
#   cp env.mega.example .env.mega     # (or: pnpm env:gather to seed from existing files)
#   <fill in the blanks>
#   pnpm env:sync                     # regenerates every per-package env file
#
# FLAT MODEL (SOLUSDEV-164): this is a plain KEY=VALUE list. `pnpm env:sync`
# writes the ENTIRE resolved file verbatim into every target env file:
#   .env · apps/desktop/.env · apps/web/.env · packages/api/.env
# Each consumer reads only the keys it recognises — the FastAPI backend reads
# SOLUS_* (pydantic Settings, env_prefix="SOLUS_"; it ignores the rest); Vite
# exposes only VITE_*; the web waitlist route reads only GOOGLE_*. Extra keys in
# a file are harmless. Define a shared value ONCE below and reference it later
# with ${VAR}. Single-quoted values are literal; bare/double-quoted interpolate.
#
# .env.mega itself is gitignored — never commit real secrets. This .example is safe.

# ---------------------------------------------------------------------------
# Shared values — defined once, referenced via ${VAR} by the prefixed keys
# below. They are emitted to every file too, but only the prefixed copies are
# read by app code.
# ---------------------------------------------------------------------------
# Supabase dashboard → Project Settings → API (URL, anon key, JWT secret).
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Required for the backend to boot (validates Supabase Auth JWTs).
SUPABASE_JWT_SECRET=

# Local FastAPI server, no path suffix — VITE_/SOLUS_ keys append their own paths.
API_BASE_URL=http://127.0.0.1:8000

# `pnpm dev:all` Postgres: user/password/db all `solus` on localhost:5432
# (docker-compose.dev.yml). Redis backs ARQ background jobs.
DB_USER=solus
DB_PASSWORD=solus
DB_HOST=localhost
DB_PORT=5432
DB_NAME=solus
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Desktop renderer (Vite) — only VITE_* is exposed to the renderer bundle.
# client.ts expects the versioned API root — keep the /api/v1 suffix or requests 404.
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=${API_BASE_URL}/api/v1
VITE_SUPABASE_URL=${SUPABASE_URL}
VITE_SUPABASE_ANON_KEY=${SUPABASE_ANON_KEY}

# ---------------------------------------------------------------------------
# FastAPI backend (SOLUS_* — packages/api/src/solus_api/core/config.py).
# --- Core ---
# dev | staging | prod. Anything but "dev" REFUSES to boot without a real
# secret store (SOLUS_SECRETS_* below) — prod must never run as "dev".
SOLUS_APP_ENV=dev
# Semver reported by /meta and the OpenAPI docs (NOT the /api/v1 route prefix).
SOLUS_API_VERSION=0.1.0
SOLUS_BUILD_SHA=dev
# Async SQLAlchemy DSN, assembled from the DB_* parts above.
SOLUS_DATABASE_URL=postgresql+asyncpg://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}
SOLUS_REDIS_URL=${REDIS_URL}
# Comma-separated browser/renderer origins allowed by CORS.
SOLUS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Dev-only: create tables from ORM metadata on startup. MUST stay false in any
# shared/prod env — schema there is owned by Alembic migrations.
SOLUS_AUTO_CREATE_TABLES=false
SOLUS_SUPABASE_JWT_SECRET=${SUPABASE_JWT_SECRET}
SOLUS_SUPABASE_JWT_AUDIENCE=authenticated
# REQUIRED for auth against a real Supabase project: modern projects sign ES256
# tokens, verified via the JWKS at {url}/auth/v1/.well-known/jwks.json (ADR-009 /
# SOLUSDEV-152). Unset ⇒ the API rejects every genuine login token with 401.
SOLUS_SUPABASE_URL=${SUPABASE_URL}

# --- Rate limiting ---
SOLUS_RATE_LIMIT_PER_MINUTE=120
# MO-04 classify preview fires on typing pauses — separate, generous bucket.
SOLUS_CLASSIFY_RATE_LIMIT_PER_MINUTE=600

# --- Teams / trial ---
SOLUS_INVITE_TTL_DAYS=7
SOLUS_TRIAL_DAYS=30

# --- Billing (ADR-024) ---
# Stripe webhook signing secret (whsec_...). Blank ⇒ the webhook rejects (503)
# and no live billing happens; credit primitives still run locally.
SOLUS_STRIPE_WEBHOOK_SECRET=
# Bounded free-trial credit grant written at signup (never unlimited).
SOLUS_TRIAL_CREDIT_GRANT=1000
# JSON map: Stripe price id → credits granted, e.g. {"price_x":1000}.
SOLUS_STRIPE_PACK_CREDITS='{}'
# Max Stripe webhook body we parse, bytes — bounds untrusted input.
SOLUS_STRIPE_WEBHOOK_MAX_BYTES=262144
# --- Stripe Checkout (SOLUSDEV-83 follow-up) — the outbound "select plan → pay" flow.
# The Stripe SECRET API key (sk_...) is NOT here — provision it in the SecretStore
# under `stripe_api_key` (AWS Secrets Manager in prod, local Fernet store in dev),
# exactly like the LLM provider keys. Until it exists, checkout returns 503.
# plan+interval → recurring Price id (JSON). Create the Products/Prices in Stripe
# ($25/mo, $200/yr BASIC; $30/mo, $300/yr PRO — ADR-023) and paste their ids:
SOLUS_STRIPE_PLAN_PRICES='{}'
# e.g. '{"basic:month":"price_...","basic:year":"price_...","pro:month":"price_...","pro:year":"price_..."}'
# Credit packs: Stripe Price id → credits granted (ADR-024 $10/$25/$50/$100 packs).
# (SOLUS_STRIPE_PACK_CREDITS above doubles as the set of valid pack price ids.)
# Free-trial length applied to a new Stripe subscription (trial_period_days). 0 = none.
SOLUS_STRIPE_TRIAL_DAYS=14
# Where Stripe returns the user after Checkout / the portal (desktop renderer routes).
SOLUS_STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:5173/#/billing?checkout=success
SOLUS_STRIPE_CHECKOUT_CANCEL_URL=http://localhost:5173/#/billing?checkout=cancel
SOLUS_STRIPE_BILLING_PORTAL_RETURN_URL=http://localhost:5173/#/billing

# --- Secret store (SOLUSDEV-103) — BOOT-BLOCKERS outside dev ---
# The backend auto-selects when SOLUS_SECRETS_BACKEND is UNSET: aws_region +
# non-dev app_env → AWS Secrets Manager; secrets_key → local Fernet store;
# neither in dev → in-memory. Non-dev with neither refuses to start.
# Uncomment ONLY to force a backend — a blank value ("") is NOT "unset" and
# disables auto-selection entirely:
# SOLUS_SECRETS_BACKEND=aws        # or: local | memory
# Fernet key for the local encrypted store. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SOLUS_SECRETS_KEY=
# AWS region for Secrets Manager (prod/staging), e.g. us-east-1.
SOLUS_AWS_REGION=us-east-1

# --- Integration OAuth apps ---
# GitHub OAuth App (github.com/settings/developers); callback must be
# ${SOLUS_PUBLIC_API_BASE_URL}/api/v1/integrations/github/oauth/callback.
SOLUS_GITHUB_CLIENT_ID=
SOLUS_GITHUB_CLIENT_SECRET=
# GitLab OAuth application; base URL supports self-hosted instances.
SOLUS_GITLAB_CLIENT_ID=
SOLUS_GITLAB_CLIENT_SECRET=
SOLUS_GITLAB_BASE_URL=https://gitlab.com
# Where the OAuth callback sends the user back to (desktop deep link/dev page).
SOLUS_GITHUB_OAUTH_REDIRECT_APP=http://localhost:5173/#/onboarding
# Public base URL providers redirect to for callbacks (this API, no /api/v1).
SOLUS_PUBLIC_API_BASE_URL=${API_BASE_URL}
# Run source syncs inline in the request — tests/bare dev only; prod uses ARQ.
SOLUS_SYNC_INLINE=true

# --- AI / fingerprint escalation ---
# NOTE — LLM provider API keys are NOT env vars. The orchestration layer
# (packages/api/src/solus_api/orchestration/providers.py) reads them from the
# SecretStore at call time, under these secret names:
#   anthropic_api_key / openai_api_key / google_api_key
# Provision them in AWS Secrets Manager (prod/staging) or the local Fernet
# store selected by SOLUS_SECRETS_* above (dev). Nothing populates them today.
SOLUS_FINGERPRINT_LLM_ENABLED=false
SOLUS_FINGERPRINT_EMBEDDING_ENABLED=false
SOLUS_FINGERPRINT_VISION_ENABLED=false

# ---------------------------------------------------------------------------
# AWS deploy config (bare names). Not read by app code — kept here so the one
# source of truth also covers ops/deploy scripts. Deploy pipelines otherwise
# read GitLab CI-scoped variables.
# ---------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCOUNT=
ECR_REPO=solus/backend
ECR_URI=${AWS_ACCOUNT}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_REPO}
DB_SECRET_ARN=
EXEC_ROLE=ecsTaskExecutionRole
INFRA_ROLE=ecsInfrastructureRoleForExpressServices
ECS_CLUSTER=solus-cluster

# ---------------------------------------------------------------------------
# Web marketing site — waitlist API route (apps/web/app/api/waitlist/route.js).
# Provide EITHER the full service-account JSON (single line) OR email+key below.
# ---------------------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# \n-escaped PEM private key; the route converts \n back to newlines.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Spreadsheet the waitlist appends to; range defaults to Waitlist!A:C in code.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_RANGE='Waitlist!A:C'
