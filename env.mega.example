# .env.mega.example — template for the single source-of-truth env file (SOLUSDEV-147).
#
# Onboarding:
#   cp env.mega.example .env.mega     # (or: pnpm env:gather to seed from existing files)
#   <fill in the blanks>
#   pnpm env:sync                     # regenerates every per-package env file
#
# `# >>> <path>` starts a block written verbatim to <path>. The `# >>> common`
# block is NEVER written — it exists so shared secrets are defined once and reused
# via ${VAR}. Bare and "double-quoted" values interpolate ${VAR}; 'single-quoted'
# values are literal. Put a space before a `#` to add an inline comment.
#
# .env.mega itself is gitignored — never commit real secrets. This .example is safe.
#
# AWS deploy variables (the former .aws.env block: ECR_URI, ECS_CLUSTER, ...) are
# GitLab CI-scoped variables now — nothing in-repo reads a local .aws.env file.

# >>> common
# Defined once here, referenced below. Not written to any file.
# Supabase dashboard → Project Settings → API (URL, anon key, JWT secret).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
# Local FastAPI server, no path suffix — blocks below append /api/v1 themselves.
API_BASE_URL=http://127.0.0.1:8000
# Async SQLAlchemy DSN. The `pnpm dev:all` Postgres uses user/password/db all
# `solus` on localhost:5432 (see docker-compose.dev.yml).
DATABASE_URL=

# >>> apps/desktop/.env
# Electron renderer (electron-vite). client.ts expects the versioned API root —
# keep the /api/v1 suffix or every request 404s.
VITE_API_BASE_URL=${API_BASE_URL}/api/v1
VITE_SUPABASE_URL=${SUPABASE_URL}
VITE_SUPABASE_ANON_KEY=${SUPABASE_ANON_KEY}

# >>> apps/desktop/.env.claude
# Agent-run profile — same keys as apps/desktop/.env; values may differ.
VITE_API_BASE_URL=${API_BASE_URL}/api/v1
VITE_SUPABASE_URL=${SUPABASE_URL}
VITE_SUPABASE_ANON_KEY=${SUPABASE_ANON_KEY}

# >>> apps/web/.env
# Next.js marketing site — waitlist API route (apps/web/app/api/waitlist/route.js).
# Provide EITHER the full service-account JSON (single line) OR email+key below.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# \n-escaped PEM private key; the route converts \n back to newlines.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Spreadsheet the waitlist appends to; range defaults to Waitlist!A:C in code.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_RANGE='Waitlist!A:C'

# >>> packages/api/.env
# FastAPI backend — pydantic Settings, SOLUS_ prefix
# (packages/api/src/solus_api/core/config.py). Every key the backend consumes.
#
# --- Core ---
# dev | staging | prod. Anything but "dev" REFUSES to boot without a real
# secret store (SOLUS_SECRETS_* below) — prod must never run as "dev".
SOLUS_APP_ENV=dev
# Semver reported by /meta and the OpenAPI docs (NOT the /api/v1 route prefix).
SOLUS_API_VERSION=0.1.0
SOLUS_BUILD_SHA=dev
SOLUS_DATABASE_URL=${DATABASE_URL}
# Redis backing ARQ background jobs; `pnpm dev:all` runs it on localhost:6379.
SOLUS_REDIS_URL=redis://localhost:6379
# Comma-separated browser/renderer origins allowed by CORS.
SOLUS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
#
# --- Auth (ADR-009) ---
SOLUS_SUPABASE_JWT_SECRET=${SUPABASE_JWT_SECRET}
SOLUS_SUPABASE_JWT_AUDIENCE=authenticated
#
# --- Database schema ---
# Schema is owned by migrations: run `alembic upgrade head`. create_all stays
# off everywhere; flip to true only in a throwaway local sandbox.
SOLUS_AUTO_CREATE_TABLES=false
#
# --- Rate limiting ---
SOLUS_RATE_LIMIT_PER_MINUTE=120
# MO-04 classify preview fires on typing pauses — separate, generous bucket.
SOLUS_CLASSIFY_RATE_LIMIT_PER_MINUTE=600
#
# --- Teams / trial ---
SOLUS_INVITE_TTL_DAYS=7
SOLUS_TRIAL_DAYS=30
#
# --- Billing (ADR-024) ---
# Stripe webhook signing secret (whsec_...). Blank ⇒ the webhook rejects (503)
# and no live billing happens; credit primitives still run locally.
SOLUS_STRIPE_WEBHOOK_SECRET=
# Bounded free-trial credit grant written at signup (never unlimited).
SOLUS_TRIAL_CREDIT_GRANT=1000
# JSON map: Stripe price id → credits granted, e.g. {"price_x":1000}.
SOLUS_STRIPE_PACK_CREDITS='{}'
# Max Stripe webhook body we parse, bytes — bounds untrusted input.
SOLUS_STRIPE_WEBHOOK_MAX_BYTES=262144
#
# --- Secret store (SOLUSDEV-103) — BOOT-BLOCKERS outside dev ---
# Backend auto-selects when SOLUS_SECRETS_BACKEND is UNSET: aws_region +
# non-dev app_env → AWS Secrets Manager; secrets_key → local Fernet store;
# neither in dev → in-memory. Non-dev with neither refuses to start.
# Uncomment ONLY to force a backend — a blank value ("") is not "unset" and
# disables auto-selection entirely:
# SOLUS_SECRETS_BACKEND=aws        # or: local | memory
# Fernet key for the local encrypted store. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SOLUS_SECRETS_KEY=
# AWS region for Secrets Manager (prod/staging), e.g. us-east-1.
SOLUS_AWS_REGION=
#
# --- Integration OAuth apps ---
# GitHub OAuth App (github.com/settings/developers); callback must be
# ${API}/api/v1/integrations/github/oauth/callback.
SOLUS_GITHUB_CLIENT_ID=
SOLUS_GITHUB_CLIENT_SECRET=
# GitLab OAuth application; base URL supports self-hosted instances.
SOLUS_GITLAB_CLIENT_ID=
SOLUS_GITLAB_CLIENT_SECRET=
SOLUS_GITLAB_BASE_URL=https://gitlab.com
# Where the OAuth callback sends the user back to (desktop deep link/dev page).
SOLUS_GITHUB_OAUTH_REDIRECT_APP=http://localhost:5173/#/onboarding
# Public base URL providers redirect to for callbacks (this API, no /api/v1).
SOLUS_PUBLIC_API_BASE_URL=${API_BASE_URL}
# Run source syncs inline in the request — tests/bare dev only; prod uses ARQ.
SOLUS_SYNC_INLINE=false
#
# --- AI / fingerprint escalation ---
# NOTE — LLM provider API keys are NOT env vars. The orchestration layer
# (packages/api/src/solus_api/orchestration/providers.py) reads them from the
# SecretStore at call time, under these secret names:
#   anthropic_api_key / openai_api_key / google_api_key
# Provision them in AWS Secrets Manager (prod/staging) or the local Fernet
# store selected by SOLUS_SECRETS_* above (dev). Nothing populates them today —
# creating those secrets is a manual operator step; until it is done, every
# model call fails with ProviderCredentialsMissingError.
SOLUS_FINGERPRINT_LLM_ENABLED=false
SOLUS_FINGERPRINT_EMBEDDING_ENABLED=false
SOLUS_FINGERPRINT_VISION_ENABLED=false

# >>> packages/api/.env.claude
# Agent-run profile — same keys as packages/api/.env (commented there);
# values may differ for agent-driven runs.
SOLUS_APP_ENV=dev
SOLUS_API_VERSION=0.1.0
SOLUS_BUILD_SHA=dev
SOLUS_DATABASE_URL=${DATABASE_URL}
SOLUS_REDIS_URL=redis://localhost:6379
SOLUS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SOLUS_SUPABASE_JWT_SECRET=${SUPABASE_JWT_SECRET}
SOLUS_SUPABASE_JWT_AUDIENCE=authenticated
SOLUS_AUTO_CREATE_TABLES=false # schema comes from `alembic upgrade head`
SOLUS_RATE_LIMIT_PER_MINUTE=120
SOLUS_CLASSIFY_RATE_LIMIT_PER_MINUTE=600
SOLUS_INVITE_TTL_DAYS=7
SOLUS_TRIAL_DAYS=30
SOLUS_STRIPE_WEBHOOK_SECRET=
SOLUS_TRIAL_CREDIT_GRANT=1000
SOLUS_STRIPE_PACK_CREDITS='{}'
SOLUS_STRIPE_WEBHOOK_MAX_BYTES=262144
# SOLUS_SECRETS_BACKEND=aws — uncomment only to force; blank breaks auto-select
SOLUS_SECRETS_KEY=
SOLUS_AWS_REGION=
SOLUS_GITHUB_CLIENT_ID=
SOLUS_GITHUB_CLIENT_SECRET=
SOLUS_GITLAB_CLIENT_ID=
SOLUS_GITLAB_CLIENT_SECRET=
SOLUS_GITLAB_BASE_URL=https://gitlab.com
SOLUS_GITHUB_OAUTH_REDIRECT_APP=http://localhost:5173/#/onboarding
SOLUS_PUBLIC_API_BASE_URL=${API_BASE_URL}
SOLUS_SYNC_INLINE=false
SOLUS_FINGERPRINT_LLM_ENABLED=false
SOLUS_FINGERPRINT_EMBEDDING_ENABLED=false
SOLUS_FINGERPRINT_VISION_ENABLED=false
