# .env.mega.example — template for the single source-of-truth env file (SOLUSDEV-147).
#
# Onboarding:
#   cp env.mega.example .env.mega     # (or: pnpm env:gather to seed from existing files)
#   <fill in the blanks>
#   pnpm env:sync                     # regenerates every per-package env file
#
# `# >>> <path>` starts a block written verbatim to <path>. The `# >>> common`
# block is NEVER written — it exists so shared secrets are defined once and reused
# via ${VAR}. Bare and "double-quoted" values interpolate ${VAR}; 'single-quoted'
# values are literal. Put a space before a `#` to add an inline comment.
#
# .env.mega itself is gitignored — never commit real secrets. This .example is safe.

# >>> common
# Defined once here, referenced below. Not written to any file.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# >>> .aws.env
AWS_ACCOUNT=
AWS_REGION=us-east-1
ECR_REPO=
ECR_URI=
ECS_CLUSTER=
DB_SECRET_ARN=
EXEC_ROLE=
INFRA_ROLE=

# >>> apps/desktop/.env
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_SUPABASE_URL=${SUPABASE_URL}
VITE_SUPABASE_ANON_KEY=${SUPABASE_ANON_KEY}

# >>> apps/desktop/.env.claude
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_SUPABASE_URL=${SUPABASE_URL}
VITE_SUPABASE_ANON_KEY=${SUPABASE_ANON_KEY}

# >>> packages/api/.env
SOLUS_DATABASE_URL=
SOLUS_SUPABASE_JWT_SECRET=${SUPABASE_JWT_SECRET}
SOLUS_AUTO_CREATE_TABLES=true

# >>> packages/api/.env.claude
SOLUS_APP_ENV=dev
SOLUS_API_VERSION=v1
SOLUS_BUILD_SHA=dev
SOLUS_DATABASE_URL=
SOLUS_SUPABASE_JWT_SECRET=${SUPABASE_JWT_SECRET}
SOLUS_SUPABASE_JWT_AUDIENCE=authenticated
SOLUS_AUTO_CREATE_TABLES=true
SOLUS_CORS_ORIGINS=http://127.0.0.1:5173
SOLUS_RATE_LIMIT_PER_MINUTE=60
SOLUS_INVITE_TTL_DAYS=7
SOLUS_TRIAL_DAYS=14
