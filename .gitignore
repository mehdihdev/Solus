# Repo-wide rules. Tech-specific rules live in per-folder .gitignore
# files (e.g. landing-page/.gitignore for the Next.js app).

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
.aws.env

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment files (never commit secrets; commit *.example instead)
.env
.env.*
!.env.example
.aws.env
*.env
.aws_env

# Dependencies / build output (safety net across any sub-folder)
node_modules/
dist/
build/
out/
.next/
.npm-cache/

# Claude harness runtime state (CLAUDE.md §3 — gitignored). The old `./claude/state`
# entry was malformed (missing the dot) and never matched.
.claude/state/


# Python bytecode
__pycache__/
*.pyc

# Tool caches / daemon state (never commit)
.dmypy.json
dmypy.json
.mypy_cache/
.pytest_cache/
.ruff_cache/
.eslintcache
